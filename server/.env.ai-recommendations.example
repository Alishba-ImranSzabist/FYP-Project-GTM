# Add these lines to server/.env (real keys stay only in this file).
# Do not commit server/.env to Git.

# Gemini — use a valid model ID such as gemini-1.5-flash or gemini-2.0-flash (v1 API)
GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-1.5-flash

# Claude — use a valid model ID such as claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=your_anthropic_console_api_key
CLAUDE_MODEL=claude-3-5-sonnet-20241022

AI_REQUEST_TIMEOUT_MS=90000
AI_MAX_OUTPUT_TOKENS=8192
