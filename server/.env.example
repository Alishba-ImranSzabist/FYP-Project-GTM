PORT=5000
NODE_ENV=development

# Local MongoDB, or paste your MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/gtm

# Use a long random string, e.g. run:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

# Brevo (ex-Sendinblue) SMTP — get these from Brevo > SMTP & API > SMTP
# The SMTP password is an SMTP KEY you generate there, NOT your Brevo login password.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-login-email@example.com
BREVO_SMTP_KEY=your-brevo-smtp-key
MAIL_FROM=GTM <your-brevo-login-email@example.com>

# OTP rules (optional — defaults shown)
# OTP_TTL_MINUTES=10
# OTP_MAX_ATTEMPTS=5
# OTP_COOLDOWN_SECONDS=60

# People signing up as "Admin" must enter this code. Leave empty to disable admin sign-up.
ADMIN_INVITE_CODE=
